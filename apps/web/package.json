{
  "name": "@xr-daw/web",
  "private": true,
  "author": "designerzen <designerzen@gmail.com>",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "dev:runtime": "vite",
    "dev:down": "iwsdk dev down",
    "dev:status": "iwsdk dev status",
    "build": "vite build",
    "serve": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "format": "prettier --write src/app tests",
    "test:browser": "iwsdk browser run tests/browser-smoke.mjs --timeout 110000",
    "test:navigation": "iwsdk browser run tests/browser-navigation.mjs --timeout 110000",
    "test:camera": "iwsdk browser run tests/browser-camera.mjs --timeout 110000",
    "test:media": "iwsdk browser run tests/browser-media.mjs --timeout 110000",
    "test:vinyl": "iwsdk browser run tests/browser-vinyl.mjs --timeout 110000",
    "test:xr": "iwsdk browser run tests/xr-enter.mjs",
    "test:ar": "iwsdk browser run tests/xr-ar.mjs"
  },
  "dependencies": {
    "@iwsdk/core": "1.0.1",
    "@pmndrs/uikit": "1.0.74",
    "@pmndrs/uikit-horizon": "1.0.74",
    "@pmndrs/uikit-lucide": "1.0.74",
    "three": "npm:super-three@0.181.0",
    "midi-file": "1.2.4",
    "webmidi": "^3.1.12"
  },
  "devDependencies": {
    "@iwsdk/cli": "1.0.1",
    "@iwsdk/vite-plugin-dev": "1.0.1",
    "@types/three": "^0.181.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.7.3",
    "vite": "^7.1.4",
    "vite-plugin-static-copy": "^3.1.0",
    "tsx": "^4.20.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
