{
  "name": "@xr-daw/web",
  "private": true,
  "author": "designerzen <designerzen@gmail.com>",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "dev:runtime": "vite",
    "dev:down": "iwsdk dev down",
    "dev:status": "iwsdk dev status",
    "build": "vite build",
    "serve": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "format": "prettier --write src/app tests",
    "test:browser": "iwsdk browser run tests/browser-smoke.mjs --timeout 110000",
    "test:navigation": "iwsdk browser run tests/browser-navigation.mjs --timeout 110000",
    "test:camera": "iwsdk browser run tests/browser-camera.mjs --timeout 110000",
    "test:scroll": "iwsdk browser run tests/browser-scroll.mjs --timeout 110000",
    "test:editing": "iwsdk browser run tests/browser-editing.mjs --timeout 110000",
    "test:composition": "iwsdk browser run tests/browser-composition.mjs --timeout 110000",
    "test:feedback": "iwsdk browser run tests/browser-feedback.mjs --timeout 110000",
    "test:musical-info": "iwsdk browser run tests/browser-musical-info.mjs --timeout 110000",
    "test:media": "iwsdk browser run tests/browser-media.mjs --timeout 110000",
    "test:formats": "iwsdk browser run tests/browser-formats.mjs --timeout 110000",
    "test:output": "iwsdk browser run tests/browser-output.mjs --timeout 110000",
    "test:vinyl": "iwsdk browser run tests/browser-vinyl.mjs --timeout 110000",
    "test:xr": "iwsdk browser run tests/xr-enter.mjs",
    "test:ar": "iwsdk browser run tests/xr-ar.mjs"
  },
  "dependencies": {
    "@iwsdk/core": "1.1.0",
    "@pmndrs/pointer-events": "6.6.32",
    "@pmndrs/uikit": "1.0.78",
    "@pmndrs/uikit-horizon": "1.0.78",
    "@pmndrs/uikit-lucide": "1.0.78",
    "audiobus": "workspace:*",
    "midi-file": "1.2.4",
    "netronome": "workspace:*",
    "three": "npm:super-three@0.185.0",
    "webmidi": "^3.3.1"
  },
  "devDependencies": {
    "@iwsdk/cli": "1.1.0",
    "@iwsdk/vite-plugin-dev": "1.1.0",
    "@types/node": "^26.6.11",
    "@types/three": "~0.185.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^7.3.8",
    "vite-plugin-static-copy": "^4.1.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
