{
  "name": "xr-daw",
  "private": true,
  "author": "designerzen <designerzen@gmail.com>",
  "license": "MIT",
  "packageManager": "npm@11.8.0",
  "workspaces": ["apps/*"],
  "scripts": {
    "dev": "turbo run dev",
    "start": "npm run dev",
    "build": "turbo run build",
    "bundle": "npm run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "check": "turbo run typecheck test build",
    "serve": "turbo run serve",
    "format": "turbo run format",
    "dev:runtime": "npm run dev:runtime --workspace @xr-daw/web",
    "dev:down": "npm run dev:down --workspace @xr-daw/web",
    "dev:status": "npm run dev:status --workspace @xr-daw/web",
    "test:browser": "npm run test:browser --workspace @xr-daw/web",
    "test:navigation": "npm run test:navigation --workspace @xr-daw/web",
    "test:media": "npm run test:media --workspace @xr-daw/web",
    "test:vinyl": "npm run test:vinyl --workspace @xr-daw/web",
    "test:xr": "npm run test:xr --workspace @xr-daw/web"
  },
  "devDependencies": { "prettier": "^3.4.2", "turbo": "2.11.10" },
  "overrides": { "three": "npm:super-three@0.181.0" },
  "engines": { "node": ">=22.12.0" }
}
