  "devDependencies": {
    "@iwsdk/cli": "1.0.1",
    "@iwsdk/vite-plugin-dev": "1.0.1",
    "@types/three": "^0.181.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.7.3",
    "vite": "^7.1.4",
    "vite-plugin-static-copy": "^3.1.0",
    "tsx": "^4.20.0",
    "prettier": "^3.4.2"
