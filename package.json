{
  "name": "xr-daw",
  "private": true,
  "author": "designerzen <designerzen@gmail.com>",
  "license": "MIT",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "postinstall": "git submodule update --init",
    "dev": "turbo run dev --filter=@xr-daw/web",
    "start": "pnpm run dev",
    "build": "turbo run build --filter=@xr-daw/web",
    "bundle": "pnpm run build",
    "test": "turbo run test --filter=@xr-daw/web",
    "typecheck": "turbo run typecheck --filter=@xr-daw/web",
    "check": "turbo run typecheck test build --filter=@xr-daw/web",
    "serve": "turbo run serve --filter=@xr-daw/web",
    "format": "turbo run format --filter=@xr-daw/web",
    "upgrade:packages": "git submodule update --remote",
    "dev:runtime": "pnpm --filter @xr-daw/web run dev:runtime",
    "dev:down": "pnpm --filter @xr-daw/web run dev:down",
    "dev:status": "pnpm --filter @xr-daw/web run dev:status",
    "test:browser": "pnpm --filter @xr-daw/web run test:browser",
    "test:navigation": "pnpm --filter @xr-daw/web run test:navigation",
    "test:camera": "pnpm --filter @xr-daw/web run test:camera",
    "test:scroll": "pnpm --filter @xr-daw/web run test:scroll",
    "test:editing": "pnpm --filter @xr-daw/web run test:editing",
    "test:media": "pnpm --filter @xr-daw/web run test:media",
    "test:formats": "pnpm --filter @xr-daw/web run test:formats",
    "test:output": "pnpm --filter @xr-daw/web run test:output",
    "test:vinyl": "pnpm --filter @xr-daw/web run test:vinyl",
    "test:xr": "pnpm --filter @xr-daw/web run test:xr",
    "test:ar": "pnpm --filter @xr-daw/web run test:ar"
  },
  "devDependencies": { "prettier": "^3.4.2", "turbo": "2.11.10" },
  "engines": { "node": ">=22.12.0" }
}
